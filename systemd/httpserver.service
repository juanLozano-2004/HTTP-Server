[Unit]
Description=Mini HTTP Server (AREP Lab 2)
After=network.target

[Service]
Type=simple
Environment=APP_PORT=8080
ExecStart=/usr/bin/java -jar /opt/httpserver/httpserver.jar
WorkingDirectory=/opt/httpserver
Restart=on-failure
User=ec2-user
StandardOutput=append:/var/log/httpserver.log
StandardError=append:/var/log/httpserver.log

[Install]
WantedBy=multi-user.target